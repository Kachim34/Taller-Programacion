procedure leerDatos_b(a:arbolVentas);
	procedure leerFecha(var r:regFecha);
	begin
		writeln('Ingrese el dia | 1..31');
		readln(r.dia);
		writeln('Ingrese el mes | 1..12');
		readln(r.mes);
		writeln('Ingrese el año | 2020..2026');
		readln(r.anio);
	end;
	function totalProductosVendidos(a:arbolVentas;r:regFecha):integer;
	begin
		if (a = nil) then
			totalProductosVendidos:=0
		else if (a^.venta.fecha.dia = r.dia) and (a^.venta.fecha.mes = r.mes) and (a^.venta.fecha.anio = r.anio) then
			totalProductosVendidos:= a^.venta.UnidadesVendidas + totalProductosVendidos(a^.HI,r) + totalProductosVendidos(a^.HD,r)
		else
			totalProductosVendidos:= totalProductosVendidos(a^.HI,r)+ totalProductosVendidos(a^.HD,r);
	end;
var
	r:regFecha;
begin
	leerFecha(r);
	writeln('se vendieron: ', totalProductosVendidos(a,r),' en esa fecha');
end;
