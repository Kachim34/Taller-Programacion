procedure generarArboles(var a1:arbolVentas; var a2:Arbol_Vendidos; var a3:arbol_iii);
{a. Implemente un módulo que genere aleatoriamente información de ventas de un comercio.
Para cada venta generar código de producto (entre 1 y 100), fecha (dia, mes, año) y cantidad de					
unidades vendidas. Finalizar con el código de producto 0. Un producto puede estar en más de
una venta.}
	{datosVenta = record
		codigoProducto: rangoCodigos;
		fecha:regFecha;
		UnidadesVendidas:integer;}

	procedure generarInformacion(var v:datosVenta);
	begin
		v.codigoProducto:= random(101);
		if v.codigoProducto <> 0 then
		begin
			v.fecha.dia:= random(31) + 1;
			v.fecha.mes:= random(12) + 1;
			v.fecha.anio:=random(7) + 2020;
			v.UnidadesVendidas:= random(150) + 1;
		end;
	end;
	
	procedure generarArbol_1(var a:arbolVentas; v:datosVenta);
	begin
		if (a = nil) then
		begin
			new(a);
			a^.venta:=v;
			a^.HI:=nil;
			a^.HD:=nil;
		end
		else if (v.codigoProducto < a^.venta.codigoProducto) then
			generarArbol_1(a^.HI,v)
		else
			generarArbol_1(a^.HD,v);
	end;
{ii. Generar y retornar otro árbol binario de búsqueda de productos vendidos ordenado por
código de producto. Cada nodo del árbol debe contener el código de producto y la
cantidad total de unidades vendidas.
		Arbol_Vendidos = ^nodoVendidos;
		
		datosVendida = record
			codigoProducto: rangoCodigos;
			UnidadesVendidas:integer;
		end;
		
		nodoVendidos = record
			ventaVendida: datosVendida;
			HI:Arbol_Vendidos;
			HD:Arbol_Vendidos;
		end;}
	procedure generarArbol_2(var a:Arbol_Vendidos; c:integer; u:integer);
	begin
		if (a=nil) then
		begin
			new(a); a^.ventaVendida.codigoProducto:= c; a^.ventaVendida.UnidadesVendidas:=u; a^.HI:=nil; a^.HD:=nil;
		end
		else if (c = a^.ventaVendida.codigoProducto) then
			a^.ventaVendida.UnidadesVendidas:= a^.ventaVendida.UnidadesVendidas + u
		else if (c < a^.ventaVendida.codigoProducto) then
			generarArbol_2(a^.HI,c,u)
		else
			generarArbol_2(a^.HD,c,u);
	end;
	
{iii. Generar y retornar otro árbol binario de búsqueda de productos vendidos ordenado por
código de producto. Cada nodo del árbol debe contener el código de producto y la lista de
las ventas realizadas del producto. Nota: No repetir información!!!
Nota: El módulo debe retornar TRES árboles.
	listaVentas = ^nodo;
	
	regVentas = record
		fecha:regFecha;
		UnidadesVendidas:integer;
	end;
	
	nodo = record
