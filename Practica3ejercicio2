		sig:listaVentas;
	end;
	
	arbol_iii = ^nodoArbol_iii;
	
	nodoArbol_iii = record
		codigo:rangoCodigos;
		ventas_iii:listaVentas;
		HI:arbol_iii;
		HD:arbol_iii;
	end;
	}
	
	procedure generarArbol_3(var a:arbol_iii; c:integer; f:regFecha; u:integer);
		procedure agregarAdelante(var l:listaVentas; f:regFecha; u:integer);
		var
			nue:listaVentas;
		begin
			new(nue);
			nue^.venta_de_lista.fecha:=f;
			nue^.venta_de_lista.UnidadesVendidas:=u;
			nue^.sig:=l;
			l:=nue;
		end;
	begin
		if (a = nil) then begin
			new(a);
			a^.ventas_iii:=nil;
			a^.codigo:=c;
			a^.HI:=nil;
			a^.HD:=nil;
			agregarAdelante(a^.ventas_iii,f,u);
		end
		else if (c = a^.codigo) then
			agregarAdelante(a^.ventas_iii,f,u)
		else if (c < a^.codigo) then
			generarArbol_3(a^.HI,c,f,u)
		else
			generarArbol_3(a^.HD,c,f,u);
	end;
	
var
	v:datosVenta;
begin
	a1:= nil; a2:=nil; a3:=nil;
	generarInformacion(v);
{i. Generar y retornar un árbol binario de búsqueda de ventas ordenado por código de
producto. Los códigos repetidos van a la derecha.}
	while (v.codigoProducto <> 0) do
	begin
		generarArbol_1(a1,v);
		generarArbol_2(a2,v.codigoProducto,v.UnidadesVendidas);
		generarArbol_3(a3,v.codigoProducto,v.fecha,v.UnidadesVendidas);
		generarInformacion(v);
	end;
end;

