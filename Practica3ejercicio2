procedure iniciar_v_c(a:Arbol_Vendidos);
	function codigoMayorVendido(a:Arbol_Vendidos):integer;
		procedure buscarMaximo(a:Arbol_Vendidos;var maxCodigo:integer; var maxUni:integer);
		begin
			if (a <> nil)then
			begin
				if (a^.ventaVendida.UnidadesVendidas > maxUni) then
				begin
					maxCodigo:=a^.ventaVendida.codigoProducto;
					maxUni:= a^.ventaVendida.UnidadesVendidas;
				end;
				buscarMaximo(a^.HI,maxCodigo,maxUni);
				buscarMaximo(a^.HD,maxCodigo,maxUni);
			end;
		end;
	var
		maxUni:integer;
		maxCodigo:integer;
	begin
		maxUni := -1;  
		maxCodigo := -1;
		buscarMaximo(a,maxCodigo,maxUni);
		codigoMayorVendido:=maxCodigo;
	end;
begin
	writeln('El codigo con mayor cantidad de unidades vendidas fue: ',codigoMayorVendido(a));
