function codigoMayorCantidadVentas(a:arbol_iii):integer;
	function contarVentas(l:listaVentas):integer;
	var
		cant:integer;
	begin
		cant:=0;
		while (l <> nil) do
		begin
			cant:= cant + 1;
			l:=l^.sig;
		end;
		contarVentas:=cant;
	end;
	
	procedure buscarMaximo(a:arbol_iii;var maxCodigo:integer ;var maxVentas:integer);
	var
		cantActual:integer;
	begin
		if (a <> nil) then
		begin
			cantActual:=contarVentas(a^.ventas_iii);
			if (cantActual > maxVentas) then
			begin
				maxCodigo:=a^.codigo;
				maxVentas:=cantActual;
			end;
			buscarMaximo(a^.HI,maxCodigo,maxVentas);
			buscarMaximo(a^.HD,maxCodigo,maxVentas);
		end;
	end;
	
var
	maxCodigo:integer;
	maxVentas:integer;
begin
	maxCodigo:=-1;
	maxVentas:=-1;
	buscarMaximo(a,maxCodigo,maxVentas);
	codigoMayorCantidadVentas:=maxCodigo;
end;
