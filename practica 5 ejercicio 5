{5) La Feria del Artesano necesita implementar un programa para obtener estadísticas sobre
las artesanías presentadas. En el programa se pide:
a) Implementar un módulo que lea información de las artesanías. De cada artesanía se
conoce: código de identificación de la artesanía, DNI del artesano y nombre del
material base. La lectura finaliza con el valor 0 para el DNI. Este módulo debe retornar
dos estructuras de datos:
i) Un árbol binario de búsqueda ordenado por el DNI del artesano. Para cada DNI del
artesano debe almacenarse la cantidad de artesanías correspondientes.
ii) Una lista que almacene en cada nodo el nombre del material base y la cantidad
total de artesanías de ese material.
b) Implementar un módulo que reciba el árbol generado en el inciso a)i), y un DNI. El
módulo debe retornar la cantidad de artesanos con DNI menor al DNI ingresado.
c) Implementar un módulo recursivo que reciba la lista generada en el inciso a)ii) y
retorne el nombre de material base con mayor cantidad de artesanías.
}


program ej5P5;
type

	artesania_reg = record
		cod_ide:integer;
		dni:integer;
		material:string;
	end;
{---------------------LISTA----------------------}
	
	lista = ^nodo_lista;
	data_l = record
		material:string;
		cant:integer;
	end;
	
	nodo_lista = record
		contenido:data_l;
		sig:lista;
	end;
	
	
{---------------------ARBOL----------------------}
	data = record
		dni:integer;
		cant:integer;
	end;
	arbol = ^nodo_arbol;
	nodo_arbol = record
		artesano:data;
		HI,HD:arbol;
	end;
{a) Implementar un módulo que lea información de las artesanías. De cada artesanía se
conoce: código de identificación de la artesanía, DNI del artesano y nombre del
material base. La lectura finaliza con el valor 0 para el DNI. Este módulo debe retornar
dos estructuras de datos:
i) Un árbol binario de búsqueda ordenado por el DNI del artesano. Para cada DNI del
artesano debe almacenarse la cantidad de artesanías correspondientes.
ii) Una lista que almacene en cada nodo el nombre del material base y la cantidad
total de artesanías de ese material.}
procedure generar_estructuras(var a:arbol;var l:lista);
	procedure generar_arbol(var a:arbol; r:artesania_reg);
		procedure asignarCampos(r:artesania_reg;var r2:data);
		begin
			r2.dni:=r.dni;
			r2.cant:=1;
		end;
	var
		r2:data;
	begin
		if (a = nil) then 
		begin
			new(a);
			asignarCampos(r,r2);
			a^.artesano:=r2;
			a^.HI:=nil;
			a^.HD:=nil;
		end
		else if (r.dni = a^.artesano.dni) then
				a^.artesano.cant:=a^.artesano.cant + 1
			else if (r.dni < a^.artesano.dni) then
				generar_arbol(a^.HI,r)
			else
				generar_arbol(a^.HD,r);
	end;
	procedure leer(var r:artesania_reg);
	begin
		r.dni:=random(10);
		if (r.dni <> 0) then
		begin
			r.cod_ide:=random(200)+1;
			writeln('NOMBRE DEL MATERIAL BASE');
			readln(r.material)
		end;
	end;
	procedure generar_lista(var l:lista;r:artesania_reg);
	var
		aux,nue:lista;
		encontre:boolean;
	begin
		encontre:=false;
		aux:=l;
		while (aux <> nil) and (not encontre) do
		begin
			if (aux^.contenido.material = r.material) then
			begin
				encontre:=true;
				aux^.contenido.cant:= aux^.contenido.cant + 1;    {--- ACA PODRIA HABER USADO UNA FUNCION QUE ME DEVUELVA EL NODO O EL PUNTERO EN ESPECIFICO DE SI ENCONTRO EL MISMO MATERIAL O NO}
			end;
			aux:=aux^.sig;
		end;
		
		if (not encontre) then
		begin
			new(nue);
			nue^.contenido.material:=r.material;
			nue^.contenido.cant:=1;
			nue^.sig:=l;
			l:=nue;
		end;
		
	end;
var
	r:artesania_reg;
begin
	a:=nil;
	l:=nil;
	leer(r);
	while (r.dni <> 0) do
	begin
		generar_arbol(a,r);
		generar_lista(l,r);
		leer(r);
	end;
	
end;
{b) Implementar un módulo que reciba el árbol generado en el inciso a)i), y un DNI. El
módulo debe retornar la cantidad de artesanos con DNI menor al DNI ingresado.}
procedure inciso_b(a:arbol);
	function cant_dni_menor(a:arbol;dni:integer):integer;
	begin
		if (a = nil) then
			cant_dni_menor:=0
		else
			if (a^.artesano.dni < dni) then
				cant_dni_menor:= 1 + cant_dni_menor(a^.HI,dni) + cant_dni_menor(a^.HD,dni)
			else
				cant_dni_menor:=cant_dni_menor(a^.HI,dni);
	end;
var
	cant_artesanos:integer;
	dni:integer;
begin
	writeln('ESCRIBA UN DNI');
	readln(dni);
	cant_artesanos:=cant_dni_menor(a,dni);
	writeln('CANTIDAD DE ARTESANOS CON DNI MENOR AL DNI INGRESADO: ',cant_artesanos);
end;
{c) Implementar un módulo recursivo que reciba la lista generada en el inciso a)ii) y
retorne el nombre de material base con mayor cantidad de artesanías.}
procedure inciso_c(l:lista);
	procedure calcular_max_nombre(l:lista;var max:integer; var nombre:string);
	begin
		if (l <> nil) then
		begin
			if (l^.contenido.cant > max) then
			begin
				max:=l^.contenido.cant;
				nombre:=l^.contenido.material;
			end;
			calcular_max_nombre(l^.sig,max,nombre);
		end;
	end;
var
	max:integer;
	nombre:string;
begin
	max:=-1;
	calcular_max_nombre(l,max,nombre);
	if (max <> -1) then
		writeln('EL MATERIAL CON MAS ARTESANIAS ES: ', nombre)
	else
		writeln('LA LISTA ESTA VACIA');
end;

var
	a:arbol;
	l:lista;
BEGIN
	randomize;
{--------INCISO A------------}
	generar_estructuras(a,l);
{--------INCISO B------------}
	inciso_b(a);
{--------INCISO C------------}
	inciso_c(l);
	
END.

