{4. Una librería requiere el procesamiento de la información de sus productos. De cada
producto se conoce el código del producto, código de rubro (del 1 al 6) y precio.
Implementar un programa que invoque a módulos para cada uno de los siguientes
puntos:
a. Lea los datos de los productos y los almacene ordenados por código de
producto y agrupados por rubro, en una estructura de datos adecuada. El
ingreso de los productos finaliza cuando se lee el precio -1.
b. Una vez almacenados, muestre los códigos de los productos pertenecientes a
cada rubro.
c. Genere un vector (de a lo sumo 20 elementos) con los productos del rubro 3.
Considerar que puede haber más o menos de 20 productos del rubro 3. Si la
cantidad de productos del rubro 3 es mayor a 20, se debe almacenar los
primeros 20 que están en la lista e ignore el resto.
d. Ordenar, por precio, los elementos del vector generado en c) utilizando el
método visto en la teoría.
e. Muestre los precios del vector resultante del punto d).
f. Calcule el promedio de los precios del vector resultante del punto d).  
}

{1) array of lists with insertar ordenado por codigo de producto y agrupados por rubro, 2) print all list within the array, c) (use dimL) generate array with products of "rubro 3" vector[3] if products > 20 then print firs's 20, else all                }
program untitled;
const
	categories = 6;
	dimf = 20;
type
	rangeCategories = 1..6;
	
	
	data = record
		code: integer;
		rubro: rangeCategories;
		price: real; 
	end;
	
	listProducts = ^node;
	
	node = record
		dataProduct: data;
		next: listProducts;
	end;
	
	vector = array[rangeCategories] of listProducts;
	
	generated_vector = array[1..dimf] of data;
	
procedure inicialize(var v:vector);
var
	i:integer;
begin
	for i:=1 to categories do
		v[i]:=nil;
end;

procedure readReg(var r:data);
begin
	writeln('PRICE');
	readln(r.price);
	if (r.price <> -1) then
	begin
		writeln('CODE');
		readln(r.code);
		writeln('RUBRO');
		readln(r.rubro);
	end;
end;

procedure insertarOrdenado(var l:listProducts; reg:data);
var
	nue,act,ant:listProducts;
begin
	new(nue);
	nue^.dataProduct:= reg;
	act:=l;
	ant:=l;
	while (act <> nil) and (act^.dataProduct.code < reg.code) do
	begin
		ant:= act;
		act:= act^.next;
	end;
	if (ant = act) then
		l:=nue
	else
		ant^.next:=nue;
	nue^.next:=act
end;

procedure readData(var v:vector);
var
	r:data; 					{1) array of lists with insertar, ordenado por codigo de producto y agrupados por rubro}
begin
	readReg(r);
	while (r.price <> -1) do
	begin
		insertarOrdenado(v[r.rubro],r);
		readReg(r);
	end;
end;

procedure printList(l:listProducts; i: integer);
begin
	while (l <> nil) do
	begin
		writeln('--------------------');
		writeln('RUBRO: ',i);
		writeln('-------------------');
		writeln('CODE: ',l^.dataProduct.code);
		writeln('-------------------');
		l:=l^.next;
	end;
end;

procedure printVectorList(v:vector);
var
	i:integer;
begin
	for i:=1 to categories do
		printList(v[i], i);
end;
procedure generateArray(var gen_v:generated_vector; l:listProducts;var diml:integer);
begin
	diml:=0;
	while (l<> nil) and (diml < dimf) do 
	begin
		diml:= diml + 1;
		gen_v[diml]:=l^.dataProduct;
		l:=l^.next;
	end;
end;
procedure sortArray(var gen_v:generated_vector; diml:integer);
var
	i,j,pos:integer;
	item:data;
begin	
	for i:= 1 to (diml-1) do
	begin
		pos:=i;
		for j:= (i+1) to diml do
			if gen_v[j].price < gen_v[pos].price then pos:=j;
	item:=gen_v[pos];
	gen_v[pos]:=gen_v[i];
	gen_v[i]:= item;
	end;
end;
procedure showPrices(v:generated_Vector; diml:integer);
var
	i:integer;
begin
	for i:= 1 to diml do
	begin
		writeln('CODE: ', v[i].code);
		writeln('PRICE: ',v[i].price:0:2);
	end;
end;
procedure averageCalculate(v:generated_vector;diml:integer;var average: real);
var
	total:real;
	i:integer;
begin
	if (diml = 0) then
		average:=0
	else
	begin
		total:=0;
		for i:=1 to diml do
			total:= total + v[i].price;
		average:= (total/diml)
	end;
end;
var
	v:vector;	
	gen_v:generated_vector;
	diml:integer;
	average:real;
BEGIN
	inicialize(v);
	readData(v);
	printVectorList(v);
	generateArray(gen_v,v[3],diml);
	sortArray(gen_v,diml);
	showPrices(gen_v,diml);
	averageCalculate(gen_v,diml,average);
	writeln('The average is: ', average:0:2);
END.

