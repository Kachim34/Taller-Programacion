}



program untitled;
type
	subGenero = 1..7;
	libro = record
		isbn: integer;
		codAutor: integer;
		genero: subGenero;
	end;
{----------------------------------ARBOL I---------------------------}
	arbol = ^nodo_arbol;
	
	data_arbol = record
		codAutor:integer;
		cant:integer;
	end;
	nodo_arbol = record	
		contenido:data_arbol;
		HI,HD:arbol;
	end;
{-----------------------VECTOR----------------}
	reg_vec = record
		genero:subGenero;
		cant:integer;
	end;
	
	vector_genero = array[subGenero] of reg_vec;
	
		
procedure leerLibro (var l: libro);
begin
	l.isbn:= Random(1000);
	if (l.isbn <> 0) then begin
		l.codAutor:= Random(300) + 100;
		l.genero:= Random(7) + 1;
	end;
end;
	

{a) Un módulo que lea información de los libros. De cada libro se conoce: ISBN, código del
autor y código del género (1: literario, 2: filosofía, 3: biología, 4: arte, 5: computación,
6: medicina, 7: ingeniería) . La lectura finaliza con el valor 0 para el ISBN (se sugiere
utilizar el módulo para leer un libro que se especifica más abajo).
Se debe retornar dos estructuras de datos:
i) Un árbol binario de búsqueda ordenado por código de autor. Para cada código
de autor debe almacenarse la cantidad de libros correspondientes al código.
ii) Un vector que almacena para cada género, el código del género y la cantidad
de libros del género.}
procedure generar_estructuras(var a:arbol;var v:vector_genero);
	procedure generar_arbol(var a:arbol;r:libro);
		procedure asignarCampos(var r2:data_arbol;r:libro);
		begin
			r2.codAutor:=r.codAutor;
			r2.cant:= 1;
		end;
	var
		r2:data_arbol;
	begin
		if (a=nil) then
		begin
			new(a);
			asignarCampos(r2,r);
			a^.contenido:=r2;
			a^.HI:=nil;
			a^.HD:=nil;
		end
		else if r.codAutor = a^.contenido.codAutor then
			a^.contenido.cant:= a^.contenido.cant + 1
			else
				if (r.codAutor < a^.contenido.codAutor) then
					generar_arbol(a^.HI,r)
				else
					generar_arbol(a^.HD,r);
	end;
	procedure inicializarVector(var v:vector_genero);
	var
		i:integer;
	begin
		for i :=1 to 7 do
		begin
			v[i].genero:=i;
			v[i].cant:=0;
		end;
	end;
	procedure generar_vector(var v:vector_genero;genero:integer);
	begin
		v[genero].cant:= v[genero].cant + 1;
	end;
var
	r:libro;
begin
	a:=nil;
	leerLibro(r);
	inicializarVector(v);
	while (r.isbn <> 0) do
	begin
		generar_arbol(a,r);
		generar_vector(v,r.genero);
		leerLibro(r);
	end;
end;
{b) Implementar un módulo que reciba el vector generado en el inciso a) y lo ordene por
cantidad de libros de mayor a menor.}
procedure ordenar_vector(var v:vector_genero);
var
	i,j,pos:integer;
	item:reg_vec;
begin
	for i := 1 to 6 do
	begin
		pos:=i;
		for j:=(i+1) to 7 do
			if v[j].cant > v[pos].cant then pos:=j;
		item:=v[pos];
		v[pos]:=v[i];
		v[i]:=item;
	end;
	
end;
