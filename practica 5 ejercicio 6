{6) Una empresa de logística necesita implementar un programa para procesar los envíos
realizados durante 2026. De cada envío se conoce el código del cliente, día, mes, código
postal de destino y peso del paquete. En el programa se debe:
a) Implementar un módulo que lea los envíos, genere y retorne un árbol binario de
búsqueda ordenado por código postal, donde para cada código postal se almacenen la
cantidad de paquetes enviados por mes. La lectura finaliza con código de cliente 0.
b) Implementar un módulo que reciba la estructura generada en el inciso a), un código
postal y un valor entero. El módulo debe retornar la cantidad de meses cuya cantidad
supere al valor entero recibido para el código postal recibido.
c) Implementar un módulo que reciba la estructura generada en el inciso a), dos códigos
postales y retorne los códigos postales dentro de los dos códigos recibidos (incluirlos),
que tuvieron al menos un mes sin envíos.
}


program untitled;
type
{-----------REGISTROS---------}
	fecha_reg = record
		dia:1..31;
		mes:1..12;
	end;
	
	envio = record
		codCli:integer;
		fecha:fecha_reg;
		codigoPostal:integer;
		peso:real;
	end;	
{---------- ARBOL--_--------}
	
	meses = array[1..12] of integer;
	
	arbol = ^nodo_arbol;
	
	data = record
		codigoPostal:integer;
		vec_meses:meses;
	end;
	nodo_arbol = record
		dato_arbol:data;
		HI,HD:arbol;
	end;
{---------LISTA------------}

	lista = ^nodo_lista;
	nodo_lista = record
		cp:integer;
		sig:lista;
	end;

{a) Implementar un módulo que lea los envíos, genere y retorne un árbol binario de
búsqueda ordenado por código postal, donde para cada código postal se almacenen la
cantidad de paquetes enviados por mes. La lectura finaliza con código de cliente 0.}
procedure inciso_a(var a:arbol);
	procedure leer(var r:envio);
	begin
		r.codCli:=random(35);
		if (r.codCli <> 0) then
		begin
			r.fecha.dia:=random(31)+1;
			r.fecha.mes:=random(12)+1;
			r.codigoPostal:=random(70)+1;
			r.peso:=random(100)+1;
		end;
	end;
	procedure generar_arbol(var a:arbol;r:envio);
		procedure inicializarVector(var v:meses);
		var
			i:integer;
		begin
			for i:=1 to 12 do
				v[i]:=0;
		end;
	begin
		if (a = nil) then
		begin
			new(a);
			a^.dato_arbol.codigoPostal:=r.codigoPostal;
			inicializarVector(a^.dato_arbol.vec_meses);
			a^.dato_arbol.vec_meses[r.fecha.mes]:=1;
			a^.HI:=nil;
			a^.HD:=nil;
		end
		else if (r.codigoPostal = a^.dato_arbol.codigoPostal) then
				a^.dato_arbol.vec_meses[r.fecha.mes]:=a^.dato_arbol.vec_meses[r.fecha.mes] + 1
			else if (r.codigoPostal < a^.dato_arbol.codigoPostal) then
					generar_arbol(a^.HI,r)
				else
					generar_arbol(a^.HD,r);
	end;
var
	r:envio;
begin
	a:=nil;
	leer(r);
	while (r.codCli <> 0) do
	begin
		generar_arbol(a,r);
		leer(r);
	end;
end;
{b) Implementar un módulo que reciba la estructura generada en el inciso a), un código
postal y un valor entero. El módulo debe retornar la cantidad de meses cuya cantidad
supere al valor entero recibido para el código postal recibido.}
procedure inciso_b(a:arbol);
	function cant_meses(a:arbol;cod,n:integer):integer;
		function recorrer_vector(v:meses;n:integer):integer;
		var
			i:integer;
			cant:integer;
		begin
			cant:=0;
			for i:=1 to 12 do
				if (v[i] > n) then
					cant:=cant+1;
			recorrer_vector:=cant;
		end;
	begin
		if (a = nil) then
			cant_meses:=0
		else
			if (cod = a^.dato_arbol.codigoPostal) then
				cant_meses:=recorrer_vector(a^.dato_arbol.vec_meses,n)
			else if (cod < a^.dato_arbol.codigoPostal) then
					cant_meses:= cant_meses(a^.HI,cod,n)
				else
					cant_meses:= cant_meses(a^.HD,cod,n);
	end;
var
	cod,n:integer;
	cant:integer;
begin
	writeln('INGRESE UN CODIGO BRODEEEEER');
	readln(cod);
	writeln('INGRESE UN VALOR BRODEEER');
	readln(n);
	cant:=cant_meses(a,cod,n);
	writeln('CANTIDAD',cant);
end;
{c) Implementar un módulo que reciba la estructura generada en el inciso a), dos códigos
postales y retorne los códigos postales dentro de los dos códigos recibidos (incluirlos),
que tuvieron al menos un mes sin envíos.
	lista = ^nodo_lista;
	nodo_lista = record
		cp:integer;
		sig:lista;
	end;

}
procedure inciso_c(a:arbol; var l:lista);
	procedure codigos(a:arbol;var l:lista;cp1,cp2:integer);
		function cumple(v:meses):boolean;
		var
			i:integer;
			ok:boolean;
		begin
			ok:=false;
			i:=1;
			while (i <= 12) and (not ok) do
			begin
				if (v[i] = 0) then
					ok:=true;
				i:=i+1;
			end;
			cumple:=ok;
		end;
		procedure agregar_lista(cp_a:integer;var l:lista);
		var
			nue:lista;
		begin
			new(nue);
			nue^.cp:=cp_a;
			nue^.sig:=l;
			l:=nue;
		end;
	begin
		if (a <> nil) then
		begin
			if (a^.dato_arbol.codigoPostal >= cp1) then
				if (a^.dato_arbol.codigoPostal <=cp2) then
				begin
					if (cumple(a^.dato_arbol.vec_meses)) then
						agregar_lista(a^.dato_arbol.codigoPostal,l);
						
					codigos(a^.HI,l,cp1,cp2);
					codigos(a^.HD,l,cp1,cp2);
				end
				else
					codigos(a^.HI,l,cp1,cp2)
			else
				codigos(a^.HD,l,cp1,cp2);
		end;
	end;
var
	cp1:integer;
	cp2:integer;
begin
	l:=nil;
	writeln('PRIMER CODIGO POSTAL');
	readln(cp1);
	writeln('SEGUNDO CODIGO POSTAL BRODEEE');
	readln(cp2);
	codigos(a,l,cp1,cp2);
end;
var
	a:arbol;
	l:lista;
BEGIN
	inciso_a(a);
	inciso_b(a);
	inciso_c(a,l);
END.

